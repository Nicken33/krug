{
  "name": "krug",
  "version": "1.0.0",
  "description": "Круг — Discord-подобный голосовой и текстовый мессенджер для друзей",
  "main": "server/server.cjs",
  "scripts": {
    "start": "node server/server.cjs",
    "build": "cd client && npm install --include=dev && npm run build",
    "dev:server": "node server/server.cjs",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  }
}
